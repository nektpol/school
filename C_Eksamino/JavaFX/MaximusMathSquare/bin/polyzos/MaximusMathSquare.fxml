<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="16.0" prefHeight="520.0" prefWidth="460.0"
          xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
          fx:controller="polyzos.Controller"
          style="-fx-background-color: #f4f6f8;">
    
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <HBox alignment="CENTER">
        <Label text="Κινήσεις:" style="-fx-font-size: 18px;" />
        <Label fx:id="counterLabel" text="0" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    </HBox>

    <GridPane alignment="CENTER" hgap="10" vgap="10">

        <Button fx:id="btnOne" text="1" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="0" GridPane.rowIndex="0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

        <Button fx:id="btnTwo" text="2" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="1" GridPane.rowIndex="0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

        <Button fx:id="btnThree" text="3" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="2" GridPane.rowIndex="0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

        <Button fx:id="btnFour" text="4" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="0" GridPane.rowIndex="1"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

        <Button fx:id="btnFive" text="5" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="1" GridPane.rowIndex="1"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

        <Button fx:id="btnSix" text="6" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="2" GridPane.rowIndex="1"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

        <Button fx:id="btnSeven" text="7" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="0" GridPane.rowIndex="2"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

        <Button fx:id="btnEight" text="8" onAction="#onButtonClick" 
                prefWidth="90" prefHeight="90" GridPane.columnIndex="1" GridPane.rowIndex="2"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;" />

    </GridPane>

    <Label fx:id="messageLabel" text="Μετακίνησε τα πλακίδια στη σωστή σειρά." style="-fx-font-size: 15px;" />
    <Button fx:id="btnShuffle" text="Νέο Παιχνίδι / Shuffle" onAction="#shuffleButtons"
            prefWidth="220" prefHeight="42"
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" />
</VBox>


