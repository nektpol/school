<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="300.0" prefWidth="400.0" 
          xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
          fx:controller="maximusmathsquare.Controller">
    
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <HBox alignment="CENTER">
        <Label text="Moves: "/>
        <Label fx:id="counterLabel" text="0"/>
    </HBox>

    <GridPane alignment="CENTER" hgap="10" vgap="10">

        <Button fx:id="btnOne" text="1" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="0" GridPane.rowIndex="0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

        <Button fx:id="btnTwo" text="2" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

        <Button fx:id="btnThree" text="3" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="2" GridPane.rowIndex="0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

        <Button fx:id="btnFour" text="4" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="0" GridPane.rowIndex="1"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

        <Button fx:id="btnFive" text="5" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="1"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

        <Button fx:id="btnSix" text="6" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="2" GridPane.rowIndex="1"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

        <Button fx:id="btnSeven" text="7" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="0" GridPane.rowIndex="2"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

        <Button fx:id="btnEight" text="8" onAction="#onButtonClick" 
                prefWidth="25" prefHeight="25" GridPane.columnIndex="1" GridPane.rowIndex="2"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;  -fx-background-radius: 5; -fx-font-size: 20" />

    </GridPane>

    <Button text="Shuffle" onAction="#shuffleButtons"
            prefWidth="100" prefHeight="25"
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 20" />
</VBox>


