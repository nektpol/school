<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="350.0" prefWidth="450.0" 
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Υπολόγισε το αποτέλεσμα:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <Label fx:id="equationLabel" style="-fx-font-size: 18px;" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnPlus" text="+" prefWidth="50.0" style="-fx-font-size: 18px;" onAction="#HandleOperatorPlus" />
        <Button fx:id="btnMinus" text="-" prefWidth="50.0" style="-fx-font-size: 18px;" onAction="#HandleOperatorMinus" />
        <Button fx:id="btnMultiply" text="*" prefWidth="50.0" style="-fx-font-size: 18px;" onAction="#HandleOperatorMultiply" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Έλεγχος" onAction="#checkAnswer" />
        <Button text="<-" onAction="#handleBackspace" />
        <Button text="Νέα Πράξη" onAction="#generateNewQuestion" />
    </HBox>

    <Label fx:id="resultLabel" text="" style="-fx-font-size: 14px;" />
</VBox>